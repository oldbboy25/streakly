<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Ring: radius 32, safely inside Android's guaranteed 33dp adaptive-icon safe-zone
         radius. Confirmed by testing that the wider 37.8dp (Play Store icon's proportion)
         DOES get visibly clipped by at least one real launcher mask. Do not widen this
         again without re-testing on-device. Drawn as one evenOdd path (outer circle minus
         inner circle) so the hole shows the gradient background through it directly,
         instead of punching out a flat color that could drift out of sync with the
         background's own gradient. -->
    <path
        android:fillColor="@color/md_on_primary"
        android:fillType="evenOdd"
        android:pathData="M22,54 A32,32 0 1,0 86,54 A32,32 0 1,0 22,54 Z
                           M30.1,54 A23.9,23.9 0 1,0 77.9,54 A23.9,23.9 0 1,0 30.1,54 Z" />
    <!-- Checkmark -->
    <path
        android:strokeColor="@color/md_on_primary"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M43.75,54.37 L51.76,62.39 L65.56,46.17" />
    <!-- Glass sheen: soft translucent highlight band across the upper ring, for a glossy look -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.32"
        android:pathData="M18,34 L90,15 L90,28 L18,46 Z" />
</vector>
