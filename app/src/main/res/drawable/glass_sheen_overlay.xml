<?xml version="1.0" encoding="utf-8"?>
<!-- Soft ambient highlight for the "glass card" finish: a translucent white sheen
     concentrated at the top, fading to nothing by mid-card. Relies on the parent
     MaterialCardView clipping its content to its own rounded corner shape. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#00FFFFFF"
        android:centerColor="#14FFFFFF"
        android:endColor="#38FFFFFF"
        android:type="linear" />
</shape>
