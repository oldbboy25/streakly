<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/achievement_icon_frame"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_emoji_circle">

        <TextView
            android:id="@+id/achievement_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="26sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/achievement_title"
        style="?attr/textAppearanceLabelMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAlignment="center"
        android:maxLines="2" />

    <TextView
        android:id="@+id/achievement_desc"
        style="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textAlignment="center"
        android:maxLines="2" />

</LinearLayout>
