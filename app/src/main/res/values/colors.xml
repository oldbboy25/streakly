<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand palette: Shadow Grey #1E1E24, Blood Red #92140C, Floral White #FFF8F0.
         Red is reserved for accents on LIGHT surfaces only, since its contrast against
         the dark grey is too low to use directly on it (checked: ~1.4:1), so dark
         surfaces pair with Floral White foregrounds instead, and red stays an accent
         used only on light backgrounds. -->
    <color name="md_primary">#92140C</color>
    <color name="md_on_primary">#FFF8F0</color>
    <color name="md_primary_container">#F0D7D0</color>
    <color name="md_on_primary_container">#2E0A07</color>

    <color name="md_secondary">#1E1E24</color>
    <color name="md_secondary_container">#E4E3E6</color>

    <color name="md_background">#FFF8F0</color>
    <color name="md_on_background">#1E1E24</color>
    <color name="md_surface">#FFF8F0</color>
    <color name="md_surface_variant">#EAE6E3</color>
    <color name="md_surface_container">#F2ECE8</color>
    <color name="md_on_surface">#1E1E24</color>
    <color name="md_on_surface_variant">#5C5650</color>
    <color name="md_outline">#8A827A</color>

    <color name="md_background_dark">#1E1E24</color>
    <color name="md_surface_dark">#1E1E24</color>
    <color name="md_surface_container_dark">#2A2A32</color>
    <color name="md_surface_variant_dark">#3A3840</color>
    <color name="md_on_surface_dark">#FFF8F0</color>
    <color name="md_on_surface_variant_dark">#C9C6C2</color>
    <color name="md_outline_dark">#7A7680</color>
    <color name="md_primary_dark">#E0503F</color>
    <color name="md_on_primary_dark">#FFF8F0</color>
    <color name="md_primary_container_dark">#5A1F18</color>
    <color name="md_on_primary_container_dark">#FFD9D0</color>
    <color name="md_secondary_dark">#C9C6C2</color>
    <color name="md_secondary_container_dark">#35343A</color>

    <!-- Bottom nav is a light bar matching the rest of the app's surfaces (was a dark
         bar matching the icon/splash; user found that too dark). -->
    <color name="bottom_nav_background">#F2ECE8</color>
    <color name="bottom_nav_icon_selected">#92140C</color>
    <color name="bottom_nav_icon_unselected">#8A827A</color>

    <color name="flame_active">#92140C</color>
    <color name="flame_inactive">#C9C4BE</color>
    <color name="chart_bar">#92140C</color>
    <color name="chart_bar_track">#EAE6E3</color>

    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="transparent">#00000000</color>

    <!-- Glass-card finish: a delicate translucent edge stroke, used the same way on
         every card regardless of light/dark theme or the card's own fill color. A
         soft white rim reads as a glass edge highlight against either. -->
    <color name="glass_border_stroke">#40FFFFFF</color>

    <!-- Habit color swatches: kept as a varied multi-color picker (independent of the
         app's own 3-color brand) so users can still visually tell their own habits
         apart. Recoloring these to only grey/red/white would remove that. -->
    <color name="swatch_green">#13874F</color>
    <color name="swatch_blue">#1E6FA8</color>
    <color name="swatch_purple">#7B4FB0</color>
    <color name="swatch_orange">#D9731F</color>
    <color name="swatch_red">#C23B30</color>
    <color name="swatch_teal">#1A8F86</color>
    <color name="swatch_pink">#C44E82</color>
    <color name="swatch_gray">#53615A</color>
</resources>
